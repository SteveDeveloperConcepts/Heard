{
  "name": "stevenola",
  "productName": "SteveNola",
  "version": "0.1.0",
  "description": "AI meeting notes: records mic + system audio only while you ask it to, transcribes live, and turns your notes into polished meeting notes with Claude.",
  "main": "./out/main/index.js",
  "author": "Steve Vaubell",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "icons": "node scripts/make-icons.mjs",
    "helper:mac": "node scripts/build-mac-helper.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && npm run helper:mac && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
