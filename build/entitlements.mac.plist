<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron's V8 under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Lets the app load its native modules (speech recognition, image tools) when it has only an
         ad-hoc signature, as `npm run dist:mac` builds it. A release signs them with its own
         Developer ID, so they'd load without this, but it keeps both builds alike. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Microphone access under the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
